// Configuración para publicar el sitio en Cloudflare (Workers con archivos estáticos).
// Cloudflare corre `npm run build` y publica la carpeta dist.
{
  "name": "raices-web",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // Rutas como /servicios/mindfulness las resuelve React Router: devolver index.html
    "not_found_handling": "single-page-application"
  }
}
